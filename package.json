{
  "name": "streamvoice",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "api": "tsx server/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "start": "tsx server/index.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "test:db-schema": "tsx --test tests/migrations.test.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "test:api-integration": "tsx --test tests/api.integration.test.ts",
    "test:all": "npm run typecheck && npx tsc -p tsconfig.server.json && npm run test:api && npm run test:db-schema && npm run build",
    "bootstrap-db": "tsx scripts/bootstrap-db.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.469.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
